# =============================================================================
# Zisriq — environment variables
# Copy to `.env.local` for local development. Never commit `.env.local`.
# Every variable below is validated at startup by src/lib/env/schema.ts.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Local dev: run `npm run db:start` and copy the values it prints.
# Production: Supabase Dashboard > Project Settings > API.

# Project REST URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe to expose in the browser — RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. FULL DATABASE ACCESS, BYPASSES RLS.
# Server-only. Never prefix with NEXT_PUBLIC_. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret used to mint short-lived client-portal tokens (see DECISIONS.md D-004).
# Local: printed by `supabase start`. Production: Project Settings > API > JWT Settings.
SUPABASE_JWT_SECRET=

# Project reference id, from Dashboard > Project Settings > General.
# Only needed when developing against a cloud project instead of the local stack.
SUPABASE_PROJECT_REF=

# --- Application ------------------------------------------------------------
# Absolute base URL, no trailing slash. Portal links in emails are built from this.
# Local: http://localhost:3000   Production: https://<your-domain>
APP_URL=http://localhost:3000

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com/api-keys
# Leave blank in development: email is routed to the console transport instead.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend before real sends work.
# e.g. "Zisriq <noreply@yourfirm.in>"
EMAIL_FROM=

# --- Cron -------------------------------------------------------------------
# Shared secret guarding /api/cron/reminders. Must match the value set in Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- AI validation layer (Phase 7, feature-flagged off) ---------------------
# https://console.anthropic.com/settings/keys — optional until Phase 7.
ANTHROPIC_API_KEY=

# --- Monitoring -------------------------------------------------------------
# Sentry DSN. Optional in development.
SENTRY_DSN=

# --- CI escape hatch --------------------------------------------------------
# Set to "1" to skip env validation during a build that has no real secrets.
# Used by CI for the production-build check. Never set this at runtime.
SKIP_ENV_VALIDATION=
